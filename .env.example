# ==========================================
# Turf Frontend - Environment Configuration Template
# ==========================================

# Centralized Public Application Domain
NEXT_PUBLIC_APP_URL=https://playzo.duckdns.org

# Centralized Public API URL
NEXT_PUBLIC_API_URL=https://playzo.duckdns.org/api

# Internal Backend Dev Server Connection (for SSR & next.config.mjs rewrites)
NEXT_PUBLIC_BACKEND_PORT=5008
BACKEND_URL=http://localhost:5008

# Live Streaming STUN/TURN (Optional override; defaults to backend ICE servers)
NEXT_PUBLIC_STUN_SERVER_URL=stun:stun.l.google.com:19302
